# Large model files
models/*.pth
models/*.pt
models/*.onnx
models/*.engine

# Large calibration data
data/calibration/*.tar.gz
data/calibration/train2017_512/
data/coco/
data/downloads/

# Build artifacts
build/
*.o
*.a
*.so
*.pyc
__pycache__/

# Logs
logs/
*.log

# Results (keep structure and summaries, exclude large runs)
results/*/raw_*/
results/*/*.cache
results/*/*.npy
results/*/*.log
results/*/*.out
results/*/*.exit
results/*/visualizations/*.png
results/*/visualizations/*.jpg

# Virtual environments
.venv/
.venv-toolchain/
*.egg-info/

# OS and IDE
.DS_Store
*.swp
*~
.vscode/
.idea/

# Git
.gitmodules

# Keep important summaries and small result files
!results/**/SUMMARY*.txt
!results/**/REPORT*.md
!results/**/*_summary.json
!results/**/*_metrics.json
